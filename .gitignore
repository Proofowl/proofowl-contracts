# Rust / Cargo build artifacts
/target

# Compiled / optimized contracts
*.wasm

# NOTE: Cargo.lock IS committed — this crate builds a deployed wasm
# artifact and the lockfile pins the exact dependency set that produced
# it, so a reviewer can reproduce the on-chain bytecode.

# Local environment & secrets
.env
.env.*
*.key

# rustfmt backups
**/*.rs.bk

# Editor / OS cruft
.DS_Store
.idea/
.vscode/

# Soroban test snapshots (regenerated by `cargo test`)
test_snapshots/
