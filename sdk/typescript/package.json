{
  "name": "@proofowl/contract-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed read-only client and canonical identifier helpers for the ProofOwl Soroban contract",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "npm@11.19.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "bash scripts/generate.sh",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"test-build/**/*.test.js\"",
    "test:integration": "PROOFOWL_INTEGRATION=1 npm test",
    "clean": "rm -rf dist test-build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.36.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
