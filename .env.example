# ProofOwl contracts — environment template
#
# Copy to `.env`, fill in the values, then load it before running a
# helper script:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# `.env` is git-ignored. NEVER put a real secret key in this file or in
# `.env` — the scripts only ever use Stellar CLI *identity aliases* and
# public `G...` / `C...` addresses. Secret keys live in your Stellar CLI
# keystore, not here.

# --- network (testnet only in this phase) --------------------------------
STELLAR_NETWORK=testnet
# Optional: override the RPC endpoint. Leave unset to use the CLI default.
# Do NOT put credentials in this URL.
# PROOFOWL_RPC_URL=https://soroban-testnet.stellar.org

# --- keystore identity aliases (NOT secret keys) ------------------------
# Create/import these with `stellar keys ...` beforehand. They must be
# distinct keys and funded on testnet where they pay fees.
PROOFOWL_ADMIN_IDENTITY=proofowl-admin-testnet
PROOFOWL_ATTESTOR_IDENTITY=proofowl-attestor-testnet
# Disposable identity used only by scripts/smoke_test.sh. You create and
# fund it; the script never does.
PROOFOWL_SMOKE_WALLET_IDENTITY=proofowl-smoke-wallet

# --- public addresses expected on-chain --------------------------------
# Used as constructor arguments and by scripts/verify_config.sh.
PROOFOWL_ADMIN_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXADMIN
PROOFOWL_ATTESTOR_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXATTESTOR

# --- set after a successful deploy ------------------------------------
# PROOFOWL_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXCONTRACT

# --- optional read source for verify_config.sh -----------------------
# Falls back to PROOFOWL_ADMIN_IDENTITY if unset.
# PROOFOWL_VERIFY_IDENTITY=proofowl-admin-testnet

# --- optional: skip interactive confirmation prompts -----------------
# Only set this in a context where you have already reviewed the action.
# PROOFOWL_ASSUME_YES=1
